      "questions": "<div class=\"section-block\" id=\"listening-part-2\">\n    <div class=\"section-head\">\n      <div class=\"num\">Questions 11–18</div>\n      <div class=\"instruction\">Choose the correct letter, <em>A, B or C</em>.</div>\n    </div>\n    <div class=\"q-card ielts-listening-question-item\" id=\"lq-card-11\"><strong class=\"ielts-listening-question-number\">11</strong>\n    <div class=\"q-row\">\n      <span class=\"q-pill\">11</span>\n      <div class=\"q-text\">The Heritage Clothes exhibition was put together by</div>\n      \n    </div>\n    <div class=\"options\"><label class=\"option\"><input type=\"radio\" name=\"practice_12_11\" value=\"A\" id=\"practice_12_11_A\" autocomplete=\"off\" aria-label=\"Question 11: A\"><span class=\"opt-letter\">A</span>museum staff.</label><label class=\"option\"><input type=\"radio\" name=\"practice_12_11\" value=\"B\" id=\"practice_12_11_B\" autocomplete=\"off\" aria-label=\"Question 11: B\"><span class=\"opt-letter\">B</span>local residents.</label><label class=\"option\"><input type=\"radio\" name=\"practice_12_11\" value=\"C\" id=\"practice_12_11_C\" autocomplete=\"off\" aria-label=\"Question 11: C\"><span class=\"opt-letter\">C</span>clothing manufacturers.</label></div>\n  </div><div class=\"q-card ielts-listening-question-item\" id=\"lq-card-12\"><strong class=\"ielts-listening-question-number\">12</strong>\n    <div class=\"q-row\">\n      <span class=\"q-pill\">12</span>\n      <div class=\"q-text\">The photographs show the clothes worn by</div>\n      \n    </div>\n    <div class=\"options\"><label class=\"option\"><input type=\"radio\" name=\"practice_12_12\" value=\"A\" id=\"practice_12_12_A\" autocomplete=\"off\" aria-label=\"Question 12: A\"><span class=\"opt-letter\">A</span>their owners.</label><label class=\"option\"><input type=\"radio\" name=\"practice_12_12\" value=\"B\" id=\"practice_12_12_B\" autocomplete=\"off\" aria-label=\"Question 12: B\"><span class=\"opt-letter\">B</span>profession