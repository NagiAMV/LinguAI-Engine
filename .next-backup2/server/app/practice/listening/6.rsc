" data-cue-end="1454.83">system</span> <span data-cue-start="1454.83" data-cue-end="1455.01">is</span> <span data-cue-start="1455.01" data-cue-end="1455.39">becoming</span> <span data-cue-start="1455.39" data-cue-end="1456.09">increasingly</span> <span data-cue-start="1456.09" data-cue-end="1457.01">advantageous.</span> (Q40)</p>7:[["$","$L12","practice-listening-6",{"test":{"id":"practice-listening-6","resource":"listening","test":6,"title":"Listening · Test 6","backUrl":"/?view=listening","audioScope":"test","parts":[{"id":1,"questions":"$13","passage":"$14","transcriptStatus":"supplied","fieldNames":["practice_6_1","practice_6_2","practice_6_3","practice_6_4","practice_6_5","practice_6_6","practice_6_7","practice_6_8","practice_6_9","practice_6_10"],"fieldLabels":{"practice_6_1":"Question 1","practice_6_2":"Question 2","practice_6_3":"Question 3","practice_6_4":"Question 4","practice_6_5":"Question 5","practice_6_6":"Question 6","practice_6_7":"Question 7","practice_6_8":"Question 8","practice_6_9":"Question 9","practice_6_10":"Question 10"},"audioUrls":["/practice/assets/listening-6.mp3"],"sourceAudioUrl":"https://ia801009.us.archive.org/13/items/mix-24m-57s-audio-joiner.com-copy-copy-copy-copy-copy-copy-copy-copy-copy/mix_24m57s%20%28audio-joiner.com%29%20-%20CopyCopyCopyCopyCopyCopyCopyCopyCopy.mp3","transcriptSpeakerStatus":"source-labelled","transcriptSpeakerProvenance":{"method":"existing-transcript-labels","reviewed":false,"audioSha256":"994b3a891191f269d3bc687cada720ec16bcf62a9d693e5fbac0f70ae6846df4","alignment":"source-labelled-with-recording-specific-voice-check","fullTranscriptSpeakerReview":true,"note":"Published Part 1 speaker labels compared against recording-specific acoustic references. No full human auditory or verbatim audit.","verifiedRanges":[{"start":49.79,"end":374.65,"method":"independent-acoustic-verification","audit":"docs/listening-speaker-review/practice-listening-6-part-1.json"}],"addedUtteranceCues":6},"transcriptWordTiming":{"source