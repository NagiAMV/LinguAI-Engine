  <div class="q-item q-card"><span class="q-num">18</span><div class="q-body"><p>Paragraph 18  <span class="ielts-listening-question-item"><strong class="ielts-listening-question-number">18</strong><select class="ansel" name="practice_single_reading_34_18" id="practice_single_reading_34_18_" autocomplete="off" aria-label="Question 18"><option value="">— choose —</option><option value="i">i</option><option value="ii">ii</option><option value="iii">iii</option><option value="iv">iv</option><option value="v">v</option><option value="vi">vi</option><option value="vii">vii</option><option value="viii">viii</option><option value="ix">ix</option></select></span></p></div></div>
