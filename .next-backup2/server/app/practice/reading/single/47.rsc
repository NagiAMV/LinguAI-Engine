  <div class="q-item q-card"><span class="q-num">17</span><div class="q-body"><p>Paragraph D  <span class="ielts-listening-question-item"><strong class="ielts-listening-question-number">17</strong><select class="ansel" name="practice_single_reading_47_17" id="practice_single_reading_47_17_" autocomplete="off" aria-label="Question 17"><option value="">— choose —</option><option value="i">i</option><option value="ii">ii</option><option value="iii">iii</option><option value="iv">iv</option><option value="v">v</option><option value="vi">vi</option><option value="vii">vii</option><option value="viii">viii</option><option value="ix">ix</option><option value="x">x</option></select></span></p></div></div>
  <div class="q-item q-card"><span class="q-num">18</span><div class="q-body"><p>Paragraph E  <span class="ielts-listening-question-item"><strong class="ielts-listening-question-number">18</strong><select class="ansel" name="practice_single_reading_47_18" id="practice_single_reading_47_18_" autocomplete="off" aria-label="Question 18"><option value="">— choose —</option><option value="i">i</option><option value="ii">ii</option><option value="iii">iii</option><option value="iv">iv</option><option value="v">v</option><option value="vi">vi</option><option value="vii">vii</option><option value="viii">viii</option><option value="ix">ix</option><option value="x">x</option></select></span></p></div></div>
  <div class="q-item q-card"><span class="q-num">19</span><div class="q-body"><p>Paragraph F  <span class="ielts-listening-question-item"><strong class="ielts-listening-question-number">19</strong><select class="ansel" name="practice_single_reading_47_19" id="practice_single_reading_47_19_" autocomplete="off" aria-label="Question 19"><option value="">— choose —</option><option value="i">i</option><option value="ii">ii</option><option value="iii">iii</option><option value="iv">iv</option><option value="v">v</option><option value="vi">vi</option><option value="vii">vii</option><option value="viii">viii</option><option value="ix">ix</option><option value="x">x</option></select></span></p></div></div>
